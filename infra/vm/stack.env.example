# /opt/retailerp/.env - settings for infra/vm/compose.yml (chmod 600).
# bootstrap.sh creates this from the example and generates POSTGRES_PASSWORD.

# API image (published by CI) and the deployed tag (deploy.sh updates API_TAG).
API_IMAGE=ghcr.io/vinodkumarsharma276/retailerp-api
API_TAG=

# Public API host name; its DNS record must point at this server (DNS only,
# not proxied) so Caddy can obtain the HTTPS certificate.
API_DOMAIN=api.retailerpai.com
ACME_EMAIL=

# Hex only (openssl rand -hex 24) so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=<generate>