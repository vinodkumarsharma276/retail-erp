# /opt/retailerp/backup.env - off-server backup target (chmod 600).
# Backups are encrypted with `age` to AGE_RECIPIENT before upload; the matching
# private key stays with the owner (password manager / offline), never on the server.

# age public key (age1...). Generate on your PC: age-keygen -o retailerp-backup.key
AGE_RECIPIENT=

# Cloudflare R2 bucket via rclone (API token scoped to this bucket, Object Read & Write).
R2_BUCKET=retailerp-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Days to keep backups in R2, and how many dumps to keep on the server.
REMOTE_RETENTION_DAYS=30
LOCAL_KEEP=7