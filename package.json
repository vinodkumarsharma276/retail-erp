{
  "name": "retail-erp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@retailerp/api --filter=@retailerp/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "dev:all": "docker compose up -d && turbo dev --filter=@retailerp/api --filter=@retailerp/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:clear": "npm run db:clear --workspace=apps/api",
    "db:clear:all": "npm run db:clear:all --workspace=apps/api",
    "db:reset": "npm run db:reset --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.5.0"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.0.0"
  }
}