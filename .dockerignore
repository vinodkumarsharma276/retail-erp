# Docker build context exclusions (repo root)
**/node_modules
**/dist
**/.turbo
.git
.github
.vscode
.idea
.claude
docs
infra

# Environment files and signing material (secrets come from the server, never the image)
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
**/*.jks
**/*.keystore
**/key.properties

# Database dumps and backups must never enter an image
**/*.dump
**/*.sql.gz
**/*.age
backups

# Apps not needed for the API image
apps/mobile
apps/mobile-flutter
apps/web

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Test/coverage
coverage
