# Web build settings for the hosted site (Cloudflare Pages). Vite bakes these in
# at build time; CI passes them from GitHub repository variables (not secrets:
# everything here ends up in public JavaScript).

# Hosted API (the client appends /api/v1).
VITE_API_URL=https://api.retailerpai.com

# <slug>.retailerpai.com selects the tenant; admin.retailerpai.com opens the
# platform console. Leave VITE_TENANT_SLUG unset so one build serves both hosts.
VITE_TENANT_APEX_DOMAINS=retailerpai.com
VITE_PLATFORM_ADMIN_SUBDOMAIN=admin