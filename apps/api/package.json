{
  "name": "@retailerp/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured yet'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:rbac": "tsx prisma/seed/rbac-and-owners.seed.ts",
    "db:clear": "tsx prisma/seed/clear.ts",
    "db:clear:all": "tsx prisma/seed/clear-all.ts",
    "db:reset": "prisma migrate reset --force",
    "db:repair:transfers": "tsx prisma/seed/repair-transfers.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:demo-unit": "tsx prisma/seed/mobile-demo-unit-attribute.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^6.6.0",
    "@retailerp/shared-types": "*",
    "@retailerp/shared-utils": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.3.0",
    "node-cron": "^4.2.1",
    "openai": "^7.27.0",
    "pdfjs-dist": "^6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
