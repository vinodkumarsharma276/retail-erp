// ============================================================================
// APP SETTINGS — Key-value config
// ============================================================================

model AppSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  /// Owning tenant. Nullable during migration; becomes NOT NULL after backfill.
  /// Existing tenant-wide (shop=null) settings still work — they're scoped
  /// per-tenant once backfilled.

  shopId    String?  @map("shop_id")
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])
  shop   Shop?  @relation(fields: [shopId], references: [id])

  @@unique([shopId, key])
  @@unique([tenantId, shopId, key])
  @@index([tenantId])
  @@map("app_settings")
}
