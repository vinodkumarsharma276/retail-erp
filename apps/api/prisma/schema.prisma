model Expense {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  /// Owning tenant (matches shopId's tenantId). Nullable during migration.

  shopId         String          @map("shop_id")
  expenseDate    DateTime        @map("expense_date") @db.Date
  category       ExpenseCategory
  vendorName     String?         @map("vendor_name") @db.VarChar(200)
  description    String?         @db.Text
  amount         Decimal         @db.Decimal(12, 2)
  gstAmount      Decimal         @default(0) @map("gst_amount") @db.Decimal(12, 2)
  invoiceNumber  String?         @map("invoice_number") @db.VarChar(100)
