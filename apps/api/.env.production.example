# =============================================================================
# RetailERP API - production settings (one value per line, no quotes).
# On the hosted VM this file is /opt/retailerp/api.env (chmod 600); bootstrap.sh
# fills the generated secrets. Never commit a filled-in copy: the repo is public.
# DATABASE_URL, NODE_ENV, API_PORT, API_HOST and TRUST_PROXY are set by
# infra/vm/compose.yml and do not belong here when using that stack.
# =============================================================================

# JWT signing keys: two different random strings, at least 32 characters each
# (openssl rand -hex 48). The API refuses to start in production without them.
# Changing them signs everyone out.
JWT_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>

# Exact web origins allowed to call the API (comma-separated, https only).
CORS_ORIGIN=https://vn.retailerpai.com,https://admin.retailerpai.com

# Tenant routing: <slug>.<apex> hosts select the tenant. Web and mobile also
# send X-Tenant-Slug, which wins. BOOTSTRAP_TENANT_SLUG only applies to
# localhost requests (development).
TENANT_APEX_DOMAINS=retailerpai.com
BOOTSTRAP_TENANT_SLUG=vn

# Requests per client IP per minute (shops share one IP per Wi-Fi network).
RATE_LIMIT_MAX=300

# Background jobs (installment reminders/overdue refresh, bank feeds).
# Run exactly one API instance with the scheduler on.
ENABLE_SCHEDULER=true
SCHEDULER_CRON=0 1 * * *
BANK_FEED_CRON=30 6 * * *
SCHEDULER_TZ=Asia/Kolkata

# Encrypts stored bank-feed credentials (>= 32 chars). Losing or changing it
# means every bank connection must be re-entered.
BANK_FEED_SECRET_KEY=<generate>

# OpenAI: invoice/register OCR, bank-statement AI, customer-name matching.
# Leave empty to disable those features.
OPENAI_API_KEY=
OCR_INVOICE_MODEL=gpt-4o-mini
OCR_REGISTER_MODEL=gpt-4o
OCR_MAX_FILE_MB=15
OCR_MAX_PDF_PAGES=8
STATEMENTS_AI_MODEL=gpt-4.1-mini
STATEMENTS_MAX_FILE_MB=30