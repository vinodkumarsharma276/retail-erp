# =============================================================================
# RetailERP API — Production Environment Variables
# Copy to .env.production and fill in real values.
# On Azure App Service, set these as Application Settings instead.
# =============================================================================

# PostgreSQL — Azure Database for PostgreSQL Flexible Server
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://retailerp:PASSWORD@retailerp-db.postgres.database.azure.com:5432/retailerp?sslmode=require

# JWT secrets — generate strong random strings (min 32 chars)
# Example: openssl rand -base64 48
JWT_SECRET=<generate-a-strong-secret>
JWT_REFRESH_SECRET=<generate-another-strong-secret>

# Server
API_PORT=3001
API_HOST=0.0.0.0

# CORS — your Static Web App URL
CORS_ORIGIN=https://retailerp.azurestaticapps.net

# Azure Blob Storage — for file uploads (invoices, photos)
AZURE_STORAGE_CONNECTION_STRING=<from-azure-portal>
AZURE_STORAGE_CONTAINER_NAME=uploads

# Node environment
NODE_ENV=production

# OCR scanning for invoice/register image parsing
# On Azure App Service, set these as Application Settings instead of committing a real key.
OCR_PROVIDER=openai
OPENAI_API_KEY=<your-openai-api-key>
OCR_INVOICE_MODEL=gpt-4o-mini
OCR_REGISTER_MODEL=gpt-4o
OCR_MAX_FILE_MB=15
OCR_MAX_PDF_PAGES=8
