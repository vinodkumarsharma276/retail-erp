DATABASE_URL=postgresql://retailerp:retailerp@localhost:5432/retailerp
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174

# OCR scanning for invoice/register image parsing
# Set these in the terminal before starting API, or load them through your environment manager.
OCR_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OCR_INVOICE_MODEL=gpt-4o-mini
OCR_REGISTER_MODEL=gpt-4o
OCR_MAX_FILE_MB=15
OCR_MAX_PDF_PAGES=8

# Bank statement API feeds: encrypts bank API credentials at rest (any random string, 32+ chars).
# Changing it means re-entering every connection. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_FEED_SECRET_KEY=
# Nightly feed sync time (needs ENABLE_SCHEDULER=true). Default 06:30 Asia/Kolkata.
# BANK_FEED_CRON=30 6 * * *
